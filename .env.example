# Anthropic / McKinsey AI Gateway
ANTHROPIC_API_KEY=your_client_id:your_client_secret
ANTHROPIC_BASE_URL=https://anthropic.prod.ai-gateway.quantumblack.com/your-gateway-id

# WhatsApp Business Cloud API
# Get these from: developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=voice_agent_webhook   # any secret string you choose — must match what you enter in Meta webhook settings

# Server
PORT=3000
